generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id               String            @id @default(cuid())
  clerkOrgId       String            @unique
  name             String
  plan             Plan              @default(FREE)
  createdAt        DateTime          @default(now())
  calls            CallLog[]
  sessions         Session[]
  agents           Agent[]
  knowledgeDocs    KnowledgeDoc[]
  knowledgeFolders KnowledgeFolder[]
}

model KnowledgeFolder {
  id             String            @id @default(cuid())
  orgId          String
  org            Organization      @relation(fields: [orgId], references: [id])
  name           String
  parentFolderId String?
  parentFolder   KnowledgeFolder?  @relation("KnowledgeFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders   KnowledgeFolder[] @relation("KnowledgeFolderHierarchy")
  knowledgeDocs  KnowledgeDoc[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([orgId])
}

model Agent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  name      String
  avatarUrl String?

  agentType    AgentType       @default(RETAIL_ECOMMERCE)
  customRole   String?
  tone         AgentTone       @default(PROFESSIONAL)
  customTone   String?
  creativity   CreativityLevel @default(BALANCED)
  instructions String?         @db.Text

  description    String?         @db.Text
  websiteUrl     String?
  welcomeMessage String?         @db.Text
  handoffEnabled Boolean         @default(true)
  status         AgentStatus     @default(ACTIVE)
  visibility     AgentVisibility @default(PRIVATE)

  defaultLanguage SupportedLanguage @default(ENGLISH)
  llmProvider     LlmProvider       @default(ANTHROPIC)
  llmModel        String            @default("claude-haiku-4-5")

  languages     AgentLanguage[]
  channels      AgentChannel[]
  knowledgeDocs AgentKnowledgeDoc[]
  variables     AgentVariable[]
  voices        AgentVoice[]

  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

model AgentVoice {
  id        String        @id @default(cuid())
  agentId   String
  provider  VoiceProvider
  voiceId   String
  name      String
  isPrimary Boolean       @default(false)
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, provider, voiceId])
  @@index([agentId])
}

model AgentLanguage {
  id       String            @id @default(cuid())
  agentId  String
  language SupportedLanguage
  agent    Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, language])
}

model AgentChannel {
  id      String           @id @default(cuid())
  agentId String
  channel AgentChannelType
  enabled Boolean          @default(true)
  config  Json?
  agent   Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, channel])
}

model AgentKnowledgeDoc {
  id             String       @id @default(cuid())
  agentId        String
  knowledgeDocId String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeDoc   KnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeDocId])
}

model AgentVariable {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key         String
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agentId, key])
  @@index([agentId])
}

model Session {
  id           String        @id @default(cuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id])
  channel      Channel
  language     String        @default("auto")
  status       SessionStatus
  customerId   String?
  agentId      String?
  agent        Agent?        @relation(fields: [agentId], references: [id])
  messages     Message[]
  summary      String?
  sentiment    Float?
  resolvedByAI Boolean       @default(false)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  createdAt    DateTime      @default(now())
  callLog      CallLog?

  @@index([orgId])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id])
  role      MessageRole
  content   String
  audioUrl  String?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model KnowledgeDoc {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  title      String
  content    String
  pineconeId String?

  sourceKind           KnowledgeSourceKind @default(TEXT)
  sourceUrl            String?
  fileUrl              String?
  folderId             String?
  folder               KnowledgeFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sizeBytes            Int                 @default(0)
  createdByClerkUserId String?

  agents    AgentKnowledgeDoc[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([orgId])
  @@index([folderId])
}

enum KnowledgeSourceKind {
  URL
  FILE
  TEXT
}

model CallLog {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  sessionId     String       @unique
  session       Session      @relation(fields: [sessionId], references: [id])
  twilioCallSid String?
  duration      Int?
  recordingUrl  String?
  transcript    String?
  qaScore       Float?
  createdAt     DateTime     @default(now())
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Channel {
  VOICE
  CHAT
  SMS
  WHATSAPP
  EMAIL
}

enum SessionStatus {
  ACTIVE
  WAITING
  BOT
  HUMAN
  RESOLVED
  ABANDONED
}

enum MessageRole {
  USER
  BOT
  AGENT
  SYSTEM
}

enum AgentStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum AgentVisibility {
  PUBLIC
  PRIVATE
}

enum AgentType {
  RETAIL_ECOMMERCE
  HEALTHCARE_MEDICAL
  FINANCE_BANKING
  REAL_ESTATE
  EDUCATION_TRAINING
  HOSPITALITY_TRAVEL
  AUTOMOTIVE
  PROFESSIONAL_SERVICES
  TECHNOLOGY_SOFTWARE
  GOVERNMENT_PUBLIC
  FOOD_BEVERAGE
  MANUFACTURING
  CUSTOM
}

enum AgentTone {
  PROFESSIONAL
  FRIENDLY
  LUXURY
  FAST_CONCISE
  EMPATHETIC
  ENERGETIC
  CALM
  CONFIDENT
  CONVERSATIONAL
  FORMAL
  SUPPORTIVE
}

enum CreativityLevel {
  STRICT
  BALANCED
  CREATIVE
}

enum AgentChannelType {
  WEB_CHAT
  WHATSAPP
  VOICE_CALLS
  MESSENGER
  INSTAGRAM
  SLACK
  EMAIL
  SMS
}

enum SupportedLanguage {
  ARABIC
  DARIJA
  FRENCH
  ENGLISH
}

enum LlmProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

enum VoiceProvider {
  ELEVENLABS
}
