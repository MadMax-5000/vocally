generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                         String                @id @default(cuid())
  clerkOrgId                 String                @unique
  name                       String
  plan                       Plan                  @default(FREE)
  /// Lemon Squeezy subscription id (stringified); used for idempotent webhook updates and portal links.
  lemonSqueezySubscriptionId String?               @unique
  lemonSqueezyCustomerId     String?
  createdAt                  DateTime              @default(now())
  calls                      CallLog[]
  sessions                   Session[]
  agents                     Agent[]
  knowledgeDocs              KnowledgeDoc[]
  knowledgeFolders           KnowledgeFolder[]
  whatsappNumbers            WhatsappPhoneNumber[]
  twilioNumbers              TwilioPhoneNumber[]
  smsNumbers                 SmsPhoneNumber[]
  emailAddresses             EmailAddress[]
  gmailConnections           GmailConnection[]
  instagramConnections       InstagramConnection[]
  messengerConnections       MessengerConnection[]
  appointments               Appointment[]
  tickets                    Ticket[]
  agentLeads                 AgentLead[]
  formSubmissions            FormSubmission[]
}

model KnowledgeFolder {
  id             String            @id @default(cuid())
  orgId          String
  org            Organization      @relation(fields: [orgId], references: [id])
  name           String
  parentFolderId String?
  parentFolder   KnowledgeFolder?  @relation("KnowledgeFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders   KnowledgeFolder[] @relation("KnowledgeFolderHierarchy")
  knowledgeDocs  KnowledgeDoc[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([orgId])
}

model Agent {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  name        String
  avatarUrl   String?
  widgetToken String? @unique
  apiToken    String? @unique

  agentType    AgentType       @default(RETAIL_ECOMMERCE)
  customRole   String?
  tone         AgentTone       @default(PROFESSIONAL)
  customTone   String?
  creativity   CreativityLevel @default(BALANCED)
  instructions String?         @db.Text

  description    String?         @db.Text
  websiteUrl     String?
  welcomeMessage String?         @db.Text
  handoffEnabled Boolean         @default(true)
  status         AgentStatus     @default(ACTIVE)
  visibility     AgentVisibility @default(PRIVATE)

  defaultLanguage SupportedLanguage @default(ENGLISH)
  llmProvider     LlmProvider       @default(ANTHROPIC)
  llmModel        String            @default("anthropic/claude-haiku-4.5")

  languages     AgentLanguage[]
  channels      AgentChannel[]
  knowledgeDocs AgentKnowledgeDoc[]
  variables     AgentVariable[]
  voices        AgentVoice[]

  sessions        Session[]
  whatsappNumbers WhatsappPhoneNumber[]
  voiceNumbers    TwilioPhoneNumber[]
  smsNumbers      SmsPhoneNumber[]
  emailAddresses  EmailAddress[]
  gmailConnection GmailConnection?
  instagramConnection InstagramConnection?
  messengerConnection MessengerConnection?
  agentLeads          AgentLead[]
  formSubmissions     FormSubmission[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

model FormSubmission {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  formId    String
  values    Json
  createdAt DateTime     @default(now())

  @@unique([agentId, sessionId, formId])
  @@index([orgId])
  @@index([agentId, createdAt(sort: Desc)])
}

model InstagramConnection {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId           String       @unique
  agent             Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  pageId            String
  pageName          String
  pageAccessTokenEnc String

  connectedAt       DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([orgId, pageId])
  @@index([orgId])
  @@index([pageId])
}

model InstagramMessageDedupe {
  id        String   @id @default(cuid())
  messageId String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GmailConnection {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId         String       @unique
  agent           Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  googleEmail     String
  refreshTokenEnc String
  historyId       String?
  watchExpiration DateTime?
  labelIds        Json         @default("[\"INBOX\"]")
  connectedAt     DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([orgId, googleEmail])
  @@index([googleEmail])
}

model MessengerConnection {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId            String       @unique
  agent              Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  pageId             String       @unique
  pageName           String?
  pageAccessTokenEnc String
  verifyTokenEnc     String
  connectedAt        DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orgId])
  @@index([pageId])
}

/// Dedupes Gmail message processing across Pub/Sub retries.
model GmailMessageDedupe {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model AgentVoice {
  id        String        @id @default(cuid())
  agentId   String
  provider  VoiceProvider
  voiceId   String
  name      String
  isPrimary Boolean       @default(false)
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, provider, voiceId])
  @@index([agentId])
}

model AgentLanguage {
  id       String            @id @default(cuid())
  agentId  String
  language SupportedLanguage
  agent    Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, language])
}

model AgentChannel {
  id      String           @id @default(cuid())
  agentId String
  channel AgentChannelType
  enabled Boolean          @default(true)
  config  Json?
  agent   Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, channel])
}

model AgentKnowledgeDoc {
  id             String       @id @default(cuid())
  agentId        String
  knowledgeDocId String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeDoc   KnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeDocId])
}

model AgentVariable {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key         String
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agentId, key])
  @@index([agentId])
}

model Session {
  id              String        @id @default(cuid())
  orgId           String
  org             Organization  @relation(fields: [orgId], references: [id])
  channel         Channel
  language        String        @default("auto")
  status          SessionStatus
  customerId      String?
  agentId         String?
  agent           Agent?        @relation(fields: [agentId], references: [id])
  messages        Message[]
  summary         String?
  sentiment       Float?
  resolvedByAI    Boolean       @default(false)
  escalatedAt     DateTime?
  escalatedReason String?
  claimedAt       DateTime?
  claimedById     String?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  callLog         CallLog?
  agentLeads      AgentLead[]
  formSubmissions FormSubmission[]
  tickets         Ticket[]

  @@index([orgId])
}

model AgentLead {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  name    String?
  email   String?
  phone   String?
  company String?
  notes   String? @db.Text
  source  Channel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, sessionId])
  @@index([orgId])
  @@index([agentId, createdAt(sort: Desc)])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id])
  role      MessageRole
  content   String
  audioUrl  String?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model VapiCallMetadata {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  vapiCallId       String   @unique
  pipelineMode     String   // realtime | cascaded
  detectedLanguage  String?
  darijaConfidence Float?
  latencyP50Ms     Int?
  latencyP95Ms     Int?
  endedReason      String?
  costBreakdown    Json?
  transferOutcome  String?  // success | failed | no_answer
  createdAt        DateTime @default(now())

  @@index([sessionId])
}

model ToolExecutionLog {
  id         String   @id @default(cuid())
  sessionId  String
  toolName   String
  parameters Json
  result     Json?
  success    Boolean
  latencyMs  Int
  createdAt  DateTime @default(now())
  
  @@index([sessionId])
}

model KnowledgeDoc {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  title      String
  content    String
  pineconeId String?

  sourceKind           KnowledgeSourceKind @default(TEXT)
  sourceUrl            String?
  fileUrl              String?
  folderId             String?
  folder               KnowledgeFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sizeBytes            Int                 @default(0)
  createdByClerkUserId String?

  agents    AgentKnowledgeDoc[]
  chunks    KnowledgeChunk[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([orgId])
  @@index([folderId])
}

model KnowledgeChunk {
  id             String                       @id @default(cuid())
  knowledgeDocId String
  knowledgeDoc   KnowledgeDoc                 @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)
  content        String
  chunkIndex     Int
  tokenCount     Int
  /// OpenAI text-embedding-3-small (1536). Read/written via raw SQL in lib/knowledge/vector-store.ts; Prisma cannot map `vector` natively.
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())

  @@index([knowledgeDocId])
}

enum KnowledgeSourceKind {
  URL
  FILE
  TEXT
}

model CallLog {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  sessionId     String       @unique
  session       Session      @relation(fields: [sessionId], references: [id])
  twilioCallSid String?
  vapiCallId    String?      @unique
  duration      Int?
  recordingUrl  String?
  transcript    String?
  qaScore       Float?
  cost          Float        @default(0)
  llmCost       Float        @default(0)
  createdAt     DateTime     @default(now())
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum Channel {
  VOICE
  CHAT
  SMS
  WHATSAPP
  EMAIL
  INSTAGRAM
  MESSENGER
}

enum SessionStatus {
  ACTIVE
  WAITING
  BOT
  HUMAN
  ESCALATED
  CLAIMED
  RESOLVED
  ABANDONED
}

enum MessageRole {
  USER
  BOT
  AGENT
  SYSTEM
}

enum AgentStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum AgentVisibility {
  PUBLIC
  PRIVATE
}

enum AgentType {
  RETAIL_ECOMMERCE
  HEALTHCARE_MEDICAL
  FINANCE_BANKING
  REAL_ESTATE
  EDUCATION_TRAINING
  HOSPITALITY_TRAVEL
  AUTOMOTIVE
  PROFESSIONAL_SERVICES
  TECHNOLOGY_SOFTWARE
  GOVERNMENT_PUBLIC
  FOOD_BEVERAGE
  MANUFACTURING
  CUSTOM
}

enum AgentTone {
  PROFESSIONAL
  FRIENDLY
  LUXURY
  FAST_CONCISE
  EMPATHETIC
  ENERGETIC
  CALM
  CONFIDENT
  CONVERSATIONAL
  FORMAL
  SUPPORTIVE
}

enum CreativityLevel {
  STRICT
  BALANCED
  CREATIVE
}

enum AgentChannelType {
  WEB_CHAT
  WHATSAPP
  VOICE_CALLS
  MESSENGER
  INSTAGRAM
  SLACK
  EMAIL
  SMS
}

enum SupportedLanguage {
  ARABIC
  DARIJA
  FRENCH
  ENGLISH
}

enum LlmProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

model WhatsappPhoneNumber {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId String?
  agent   Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  twilioNumber String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@index([twilioNumber])
  @@index([orgId, agentId])
}

model WhatsappMessageDedupe {
  id        String   @id @default(cuid())
  messageId String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TwilioPhoneNumber {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId String?
  agent   Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  twilioNumber String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@index([twilioNumber])
}

model SmsPhoneNumber {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  twilioNumber String       @unique
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId])
  @@index([twilioNumber])
}

model SmsMessageDedupe {
  id        String   @id @default(cuid())
  messageId String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EmailAddress {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  email     String       @unique
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
  @@index([email])
}

/// Dedupes Resend `email.received` webhook retries so we do not double-reply or double-charge LLM.
model InboundEmailDedupe {
  id            String   @id @default(cuid())
  resendEmailId String   @unique
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model Appointment {
  id            String            @id @default(cuid())
  orgId         String
  organization  Organization      @relation(fields: [orgId], references: [id])
  sessionId     String?
  customerName  String
  customerEmail String?
  department    String
  date          DateTime
  time          String
  status        AppointmentStatus @default(CONFIRMED)
  notes         String?
  createdAt     DateTime          @default(now())

  @@index([orgId])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Ticket {
  id            String         @id @default(cuid())
  orgId         String
  organization  Organization   @relation(fields: [orgId], references: [id])
  sessionId     String?
  session       Session?       @relation(fields: [sessionId], references: [id])
  subject       String
  description   String
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  customerEmail String?
  createdAt     DateTime       @default(now())

  @@index([orgId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum VoiceProvider {
  ELEVENLABS
  OPENROUTER
}
