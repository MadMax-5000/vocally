# Supabase (Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase — Storage (knowledge file uploads; server uses service role)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; default "knowledge" in code. Create the bucket in Supabase Dashboard.
# SUPABASE_KNOWLEDGE_BUCKET=

# Used to check if the signed in user is the author of this project (for admin features)
NEXT_PUBLIC_AUTHOR_EMAIL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SECRET=

# LLM (Anthropic Claude — used in AI pipeline)
ANTHROPIC_API_KEY=

# Embeddings (OpenRouter — free tier available)
OPENROUTER_API_KEY=

# TTS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Supabase Vector (pgvector) — enable via prisma/migrations/001_enable_pgvector.sql
# Embedding model: text-embedding-3-small (OpenAI)

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Analytics (your preferred key name)
NEXT_PUBLIC_MEASUREMENT_ID=

