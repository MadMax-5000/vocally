# Feature Flags
VOICE_PIPELINE=vapi # 'legacy' (Twilio Media Streams) or 'vapi'

# Supabase (Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase — Storage (knowledge file uploads; server uses service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; default "knowledge" in code. Create the bucket in Supabase Dashboard.
# SUPABASE_KNOWLEDGE_BUCKET=

# Used to check if the signed in user is the author of this project (for admin features)
NEXT_PUBLIC_AUTHOR_EMAIL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Twilio (parent ISV account — used for subaccount provisioning and legacy/sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=  # Legacy/sandbox only; production uses per-org senders via Embedded Signup
TWILIO_SMS_NUMBER=      # e.g. +15551234567 (Twilio SMS-capable number for inbound/outbound SMS)
TWILIO_VOICE_NUMBER=    # e.g. +15551234567 (Twilio voice-enabled number for inbound PSTN calls)
TWILIO_WEBHOOK_SECRET=
# Dev only: skip Meta Embedded Signup and use TWILIO_WHATSAPP_NUMBER sandbox mapping
# WHATSAPP_SANDBOX_MODE=true

# AI — LLM & Embeddings (single OpenRouter key for all models)
OPENROUTER_API_KEY=

# Vapi & Voice
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=
HANDOFF_PHONE_NUMBER=

# Deepgram — Streaming ASR (real-time transcription)
DEEPGRAM_API_KEY=

# TTS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Resend — send + receive (inbound AI)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Signing secret from Resend → Webhooks (Svix). Required in production for POST /api/webhooks/email/inbound
RESEND_WEBHOOK_SECRET=

# Gmail agent deploy (OAuth + Pub/Sub push). See docs/gmail-deploy.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_PUBSUB_TOPIC=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Public app URL for OAuth redirect and Pub/Sub JWT audience (e.g. https://app.example.com)
NEXT_PUBLIC_APP_URL=
# Dev only: skip Pub/Sub JWT verification
# GMAIL_PUBSUB_SKIP_VERIFY=true

# Meta (Facebook) — Messenger channel (OAuth + Webhooks + Send API)
META_APP_ID=
META_APP_SECRET=
# Optional override; defaults to ${NEXT_PUBLIC_APP_URL}/api/oauth/meta/callback
META_OAUTH_REDIRECT_URI=
# Optional override; defaults to v25.0
# META_GRAPH_VERSION=v25.0

# Meta WhatsApp Embedded Signup (Tech Provider / ISV onboarding)
# Create config in Meta App Dashboard → WhatsApp → Embedded Signup
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
NEXT_PUBLIC_META_PARTNER_SOLUTION_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Lemon Squeezy — billing (https://docs.lemonsqueezy.com)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Settings » Stores in Lemon Squeezy
LEMONSQUEEZY_STORE_ID=
# Product variant IDs (Settings » Products » variant row). Used for checkout + webhook plan mapping.
LEMONSQUEEZY_VARIANT_ID_STARTER=
LEMONSQUEEZY_VARIANT_ID_PRO=
# Optional self-serve enterprise variant; omit if sales-led only.
# LEMONSQUEEZY_VARIANT_ID_ENTERPRISE=
# Webhook URL in Lemon: https://<your-domain>/api/webhooks/lemonsqueezy — enable subscription_* events.
# Optional: force Lemon checkout test mode (matches Lemon Squeezy test mode in dashboard).
# LEMONSQUEEZY_TEST_MODE=false
# ISO 4217 code used when formatting variant prices on /pricing (variant `price` is in cents).
LEMONSQUEEZY_PRICE_CURRENCY=USD

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional — when set, Sentry uploads source maps during `next build`
SENTRY_AUTH_TOKEN=

# Google Analytics (your preferred key name)
NEXT_PUBLIC_MEASUREMENT_ID=

