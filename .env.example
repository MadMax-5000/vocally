# Supabase (Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase — Storage (knowledge file uploads; server uses service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; default "knowledge" in code. Create the bucket in Supabase Dashboard.
# SUPABASE_KNOWLEDGE_BUCKET=

# Used to check if the signed in user is the author of this project (for admin features)
NEXT_PUBLIC_AUTHOR_EMAIL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=  # e.g. +14155238886 (Twilio Sandbox number, with or without whatsapp: prefix)
TWILIO_SMS_NUMBER=      # e.g. +15551234567 (Twilio SMS-capable number for inbound/outbound SMS)
TWILIO_VOICE_NUMBER=    # e.g. +15551234567 (Twilio voice-enabled number for inbound PSTN calls)
TWILIO_WEBHOOK_SECRET=

# AI — LLM & Embeddings (single OpenRouter key for all models)
OPENROUTER_API_KEY=

# Deepgram — Streaming ASR (real-time transcription)
DEEPGRAM_API_KEY=

# TTS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Lemon Squeezy — billing (https://docs.lemonsqueezy.com)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Settings » Stores in Lemon Squeezy
LEMONSQUEEZY_STORE_ID=
# Product variant IDs (Settings » Products » variant row). Used for checkout + webhook plan mapping.
LEMONSQUEEZY_VARIANT_ID_STARTER=
LEMONSQUEEZY_VARIANT_ID_PRO=
# Optional self-serve enterprise variant; omit if sales-led only.
# LEMONSQUEEZY_VARIANT_ID_ENTERPRISE=
# Webhook URL in Lemon: https://<your-domain>/api/webhooks/lemonsqueezy — enable subscription_* events.
# Optional: force Lemon checkout test mode (matches Lemon Squeezy test mode in dashboard).
# LEMONSQUEEZY_TEST_MODE=false
# ISO 4217 code used when formatting variant prices on /pricing (variant `price` is in cents).
LEMONSQUEEZY_PRICE_CURRENCY=USD

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Analytics (your preferred key name)
NEXT_PUBLIC_MEASUREMENT_ID=

